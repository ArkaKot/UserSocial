@model UserSocial.Core.ViewModels.SocialLinkViewModel

@{
    ViewData["Title"] = "Moje linki";
}

<h1>Moje linki</h1>

<div id="linkSocialTable">
    @await Html.PartialAsync("_MySocialLinkTable.cshtml", Model.Links)
</div>

@section Scripts
{
    <script type="text/javascript">
        $(document).ready(function () {

        });

        function deleteSocialLink(id, btn) {
            if (!confirm("Czy na pewno chcesz usunąć link?"))
                return;


            $.ajax({
                type: "POST",
                url: "@Url.Action("Delete", "SocialLink")",
                data: {
                    id: id
                },
                success: function (data) {
                    if (data.success) {
                        var row = btn.parentNode.parentNode;
                        row.parentNode.removeChild(row);
                    }
                    else {
                        alert(data.message);
                    }
                },
                error: function (data) {
                    alert(data.message)
                },
                dataType: "json"
            });
        
        }
    </script>
    }