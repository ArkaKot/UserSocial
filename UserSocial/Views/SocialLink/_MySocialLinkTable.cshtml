@model IEnumerable<UserSocial.Core.Models.Domains.LinkSocial>

<div id="linkSocialTable">
@if (Model != null && Model.Any())
{
        <table class="table table-hover table-striped mt-3 mb-5">
            <thead>
                <tr>
                    <th scope="col">Nazwa</th>
                    <th scope="col">Adres</th>

                </tr>
            </thead>
            <tbody>
                @foreach (var socialLink in Model)
                {
                    <tr>
                        <td>@socialLink.Title</td>
                        <td>@socialLink.Link</td>
                        <td>
                            <a class="btn btn-primary btn-sm"
                               href="@Url.Action("MySocialLinks", "SocialLink", new { id = socialLink.Id })">
                                Edytuj
                            </a>
                           
                            <button class="btn btn-danger btn-sm" onclick="deleteSocialLink('@socialLink.Id',this)">
                                Usuń
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        }
        else
        {
        <div>
            Brak linków.
        </div>
}
</div>