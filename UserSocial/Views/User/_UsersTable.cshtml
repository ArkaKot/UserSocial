@model IEnumerable<UserSocial.Core.Models.Domains.ApplicationUser>

<div id="usersTable">
@if (Model != null && Model.Any())
{
        <table class="table table-hover table-striped mt-3 mb-5">
            <thead>
                <tr>
                    <th scope="col">Zdjęcie Profilowe</th>
                    <th scope="col">Nazwa Użytkownika</th>
                    <th scope="col">Nazwa Konta</th>
                    <th scope="col">Email</th>
                    <th scope="col">Numer Telefonu</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td><img src="@user.Picture" width="150" height="150" style="border-radius: 50%" /></td>
                        <td>@user.UserName</td>
                        <td>@user.NameAccount</td>
                        <td>@user.Email</td>
                        <td>@user.PhoneNumber</td>
                    </tr>
                }
            </tbody>
        </table>

        }
        else
        {
        <div>
            Brak ostatnich użytkowników.
        </div>
}
</div>